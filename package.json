{
  "name": "noetia",
  "private": true,
  "version": "0.1.0",
  "description": "Um espaço local para ler, escrever e conectar suas notas Markdown.",
  "license": "MIT",
  "author": "Marcus Vinicius",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirDarky/noetia.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:desktop": "tauri build",
    "tauri": "tauri",
    "package:windows": "powershell -NoProfile -File scripts/package-windows.ps1",
    "notices": "node scripts/generate-notices.mjs",
    "check:public": "node scripts/check-public-source.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.0.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "katex": "^0.19.0",
    "dompurify": "^3.4.17"
  }
}
